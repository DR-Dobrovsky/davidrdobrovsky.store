# Cloudflare Pages reads this file and applies the headers below.
# Tighten rather than loosen: every allowance here is attack surface.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self)
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self' https://api.stripe.com; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Filenames are not content-hashed, so `immutable` would be wrong: a returning
# visitor could keep a stale styles.css for up to a year. With must-revalidate
# the browser sends a conditional request and gets a cheap 304 when nothing
# changed, while Cloudflare still serves from its edge cache.
#
# If asset traffic ever justifies it, add content hashes to the filenames and
# only then switch these back to immutable.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Images are replaced rarely, but under the same filenames, so a day is a
# reasonable compromise between freshness and repeat-visit speed.
/assets/img/*
  Cache-Control: public, max-age=86400, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
