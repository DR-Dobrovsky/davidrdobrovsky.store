{
  "name": "seoulsilk-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One-product store: Moev Hair Steamer Pro + Growus bundles",
  "scripts": {
    "test": "node tests/smoke.mjs && node tests/worker.mjs && node tests/assets.mjs && node tests/csp.mjs && node tests/images.mjs",
    "test:site": "node tests/smoke.mjs",
    "test:worker": "node tests/worker.mjs",
    "test:assets": "node tests/assets.mjs",
    "bundles": "node scripts/build-bundles.mjs",
    "images": "node scripts/build-images.mjs && node scripts/build-picture.mjs",
    "build": "npm run bundles",
    "check:live": "node scripts/check-live.mjs",
    "preview": "cd site && python3 -m http.server 8080",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail --format pretty",
    "test:csp": "node tests/csp.mjs",
    "picture": "node scripts/build-picture.mjs",
    "test:images": "node tests/images.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.3"
  }
}
